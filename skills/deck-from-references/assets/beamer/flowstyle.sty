% flowstyle.sty -- light, figure-first Beamer style for the stage (presentation) deck:
% takeaway headline, boxes joined by arrows (input -> operation -> output), bold takeaway, next question.
% Options: ja | en.  Use with \documentclass[aspectratio=169,11pt,t]{beamer}.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{flowstyle}[2026/11/03 light figure-first talk style]
\newif\iftalkja\talkjafalse
\DeclareOption{ja}{\talkjatrue}\DeclareOption{en}{\talkjafalse}
\ProcessOptions\relax
\iftalkja\RequirePackage[ja]{.agents/skills/deck-from-references/assets/beamer/talkbase}\else\RequirePackage[en]{.agents/skills/deck-from-references/assets/beamer/talkbase}\fi

\definecolor{fnavy}{HTML}{1F2A6B}\definecolor{fred}{HTML}{C0272D}\definecolor{fcyan}{HTML}{1B7FC4}
\definecolor{fpanel}{HTML}{E9F1FA}\definecolor{fgrey}{HTML}{6B7684}\definecolor{fink}{HTML}{15171C}
% aliases so that pages shared with the dark reading deck (code pages) compile in both styles
\colorlet{tstext}{fink}\colorlet{tsgrey}{fgrey}\colorlet{tsbg}{white}\colorlet{tsteal}{fcyan}\colorlet{tsamber}{fred}
\setbeamercolor{background canvas}{bg=white}\setbeamercolor{normal text}{fg=fink,bg=white}
\setbeamertemplate{navigation symbols}{}
\geometry{paperwidth=17.6cm,paperheight=9.9cm}
\setbeamersize{text margin left=0.9cm,text margin right=0.9cm}
\setbeamerfont{normal text}{size=\fontsize{11}{15}\selectfont}
\setbeamertemplate{itemize items}{\raisebox{0.15ex}{\color{fred}\fontsize{5}{5}\selectfont$\blacktriangleright$}}
\newcommand{\teal}[1]{{\color{fcyan}#1}}\newcommand{\amber}[1]{{\color{fred}#1}}\newcommand{\grey}[1]{{\color{fgrey}#1}}

% small position tag (top left) and page number (bottom right)
\newcommand{\talktag}[1]{\gdef\fstag{#1}}\gdef\fstag{}
\newcommand{\talkfooter}{}\newcommand{\talktabs}{}\newcommand{\tab}[2]{}\newcommand{\talktotal}{}
\setbeamertemplate{headline}{\leavevmode\hbox to\paperwidth{\hspace{0.9cm}\vbox{\vskip4pt{\fontsize{7}{8.5}\selectfont\color{fgrey}\fstag}}}}
\setbeamertemplate{footline}{\leavevmode\hbox to\paperwidth{\hspace{0.9cm}\vbox{\hbox to\dimexpr\paperwidth-1.8cm\relax{{\fontsize{6.5}{8}\selectfont\color{fgrey}\talkfooter\hfill\insertframenumber}}\vskip3pt}}}
% headline = the takeaway sentence of the page (a claim); no subtitle
\setbeamertemplate{frametitle}{\vspace{-1pt}{\centering\fontsize{14}{17}\selectfont\bfseries\color{fnavy}\insertframetitle\par}\vspace{5pt}}

% a box with a red title above it; it is at least \flowh high and grows with its content,
% and all boxes on one page share the height of the tallest (two LaTeX passes)
\newcommand{\flowbox}[3][0.3\linewidth]{\begin{minipage}[t]{#1}%
  {\centering\color{fred}\bfseries\fontsize{9}{11}\selectfont #2\par}\vspace{2pt}%
  \begin{tcolorbox}[enhanced,colback=white,colframe=fnavy,boxrule=0.7pt,arc=0pt,left=3pt,right=3pt,top=3pt,bottom=3pt,halign=center,valign=center,height=\flowh,height plus=40cm,equal height group=flowpage\the\c@page]%
  \fontsize{9.5}{12.5}\selectfont #3\end{tcolorbox}\end{minipage}}
\newlength{\flowh}\setlength{\flowh}{2.5cm}
\newcommand{\flowarrow}{\raisebox{-\dimexpr\flowh/2+0.2cm\relax}{\tikz[baseline]\draw[-{Stealth[length=3.6mm,width=3mm]},line width=2.2pt,color=fred](0,0)--(0.75,0);}}
% pipelines of 2, 3 or 4 boxes; arguments: title and content of each box
\newcommand{\pipeII}[4]{\noindent\flowbox[0.43\linewidth]{#1}{#2}\hfill\flowarrow\hfill\flowbox[0.43\linewidth]{#3}{#4}\par}
\newcommand{\pipeIII}[6]{\noindent\flowbox[0.27\linewidth]{#1}{#2}\hfill\flowarrow\hfill\flowbox[0.27\linewidth]{#3}{#4}\hfill\flowarrow\hfill\flowbox[0.27\linewidth]{#5}{#6}\par}
\newcommand{\pipeIV}[8]{\noindent\flowbox[0.195\linewidth]{#1}{#2}\hfill\flowarrow\hfill\flowbox[0.195\linewidth]{#3}{#4}\hfill\flowarrow\hfill\flowbox[0.195\linewidth]{#5}{#6}\hfill\flowarrow\hfill\flowbox[0.195\linewidth]{#7}{#8}\par}

% bottom: source tag, bold takeaway, cyan next question
\newcommand{\srctag}[1]{\vfill{\raggedright\fontsize{7}{8.5}\selectfont\color{fgrey}#1\par}\vspace{2pt}}
\newcommand{\closing}[2][]{{\centering\bfseries\color{fnavy}\fontsize{11}{14}\selectfont #2\par}%
  \if\relax\detokenize{#1}\relax\else{\centering\color{fcyan}\fontsize{9}{11}\selectfont $\rightarrow$\ #1\par}\fi}
\newcommand{\figcard}[1]{\begin{tcolorbox}[enhanced,hbox,colback=white,colframe=fnavy,boxrule=0.5pt,arc=0pt,left=2pt,right=2pt,top=2pt,bottom=2pt,before skip=2pt,after skip=2pt]#1\end{tcolorbox}}
\newcommand{\chip}[1]{{\color{fred}\fbox{\fontsize{7}{8.5}\selectfont\strut#1}}}
\newcommand{\figcap}[2]{{\fontsize{8.5}{11}\selectfont\color{fnavy}\textbf{#1}\ \color{fgrey}#2\par}}
\newtcolorbox{tbox}[2][]{enhanced,colback=fpanel,colframe=fpanel,coltext=fink,coltitle=fred,
  fonttitle=\bfseries\fontsize{10}{12}\selectfont,title={#2},boxrule=0pt,arc=2pt,left=5pt,right=5pt,top=3pt,bottom=3pt,before skip=3pt,after skip=3pt,#1}
% numbered marker appended to a code line by extract_code.py, and the "look at" list beside the code
\newcommand{\mk}[1]{\ \tikz[baseline=(mkn.base)]\node[circle,fill=fred,text=white,inner sep=1pt,font=\fontsize{6}{6}\selectfont\bfseries](mkn){#1};}
\newenvironment{lookat}{\begin{tbox}{\T{Look at}{見どころ}}\fontsize{7.6}{9.6}\selectfont}{\end{tbox}}
\newcommand{\lookitem}[3]{\par\noindent\tikz[baseline=(lkn.base)]\node[circle,fill=fred,text=white,inner sep=1pt,font=\fontsize{6}{6}\selectfont\bfseries](lkn){#1};\ \teal{#2}\ #3\par\vspace{0.5pt}}
\lstset{language=Python,basicstyle=\ttfamily\fontsize{8}{9.8}\selectfont\color{fink},keywordstyle=\color{fnavy}\bfseries,
  commentstyle=\color{fgrey},stringstyle=\color{fred},showstringspaces=false,columns=fixed,keepspaces=true,
  backgroundcolor=\color{fpanel},frame=none,numbers=left,numberstyle=\tiny\color{fgrey},xleftmargin=12pt,breaklines=true}
\lstdefinestyle{codepage}{basicstyle=\ttfamily\fontsize{7.2}{8.6}\selectfont\color{fink},xleftmargin=10pt,aboveskip=0pt,belowskip=0pt,escapeinside={(*@}{@*)},moredelim=[is][\color{fgrey!55}]{@!}{!@}}
% roles (names say the intent): inherited = kept from the earlier method; fix = changed to overcome the
% obstacle that motivates the subsection; aim = changed for another intended purpose (emphasized and explained);
% tidy = bookkeeping (quiet); forward = a limit that leads to the next subsection. Not every role occurs on every page.
\definecolor{fcyanfwd}{HTML}{1B7FC4}
\def\rkI{inherited}\def\rkF{fix}\def\rkA{aim}
\newcommand{\mkdraw}[2]{\tikz[baseline=(mkn.base)]\node[circle,inner sep=1pt,font=\fontsize{6}{6}\selectfont\bfseries,#1](mkn){#2};}
\newcommand{\mkr}[2]{\def\mkcur{#1}\ \ifx\mkcur\rkI\mkdraw{draw=fgrey,text=fgrey}{#2}\else\ifx\mkcur\rkF\mkdraw{fill=fred,text=white}{#2}\else\ifx\mkcur\rkA\mkdraw{fill=fnavy,text=white}{#2}\else\mkdraw{fill=fcyanfwd,text=white}{#2}\fi\fi\fi}
\newcommand{\rolelab}[1]{{\fontsize{8}{9.5}\selectfont\bfseries\def\mkcur{#1}\ifx\mkcur\rkI\color{fgrey}\T{KEPT}{従来のまま}\else\ifx\mkcur\rkF\color{fred}\T{FIXES THE OBSTACLE}{障害を克服}\else\ifx\mkcur\rkA\color{fnavy}\T{OTHER AIM}{別の狙い}\else\color{fcyanfwd}\T{LIMIT $\to$ NEXT}{残る限界 $\to$ 次}\fi\fi\fi}}
\newcommand{\lookitemr}[4]{\par\noindent\mkr{#1}{#2}\ \rolelab{#1}\ \teal{#3}\ #4\par\vspace{0.5pt}}
\endinput
